# Supabase Configuration
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# Note: The publishable key is the "anon" / "publishable" key from Supabase.
# The service_role key should NEVER be exposed in frontend code.

# Multi-Tenant Configuration (Phase 9)
# Default campus slug — legacy/non-prefixed URLs (e.g. /phase-1) redirect here.
VITE_DEFAULT_CAMPUS_SLUG=default
# Feature flag: when disabled, the app behaves as a single-tenant app with
# legacy flat URLs (no /:campusSlug/ prefix).
VITE_MULTI_TENANT_ENABLED=true

# Error Tracking (optional — audit finding D3)
# Sentry DSN for error monitoring. When unset, error tracking stays disabled.
# Create a project at https://sentry.io and paste the DSN (https://<key>@o<org>.ingest.sentry.io/<project>).
VITE_SENTRY_DSN=
